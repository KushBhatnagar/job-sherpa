# Copy to .env (gitignored) or me/.env and fill in what you use. All optional.

# --- Adzuna: keyword search across employers not in your companies.yaml ---
# Free key: https://developer.adzuna.com . Also set [search].adzuna_country
# in me/profile.toml.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Database backups ---
# Your database is gitignored, so this is its only other copy. Every sherpa
# command backs it up here when the newest backup is over 7 days old;
# `sherpa backup` does it now. A synced cloud-drive folder works well.
# The folder's parent must already exist.
SHERPA_BACKUP_DIR=
SHERPA_BACKUP_KEEP=8

# --- Keep your private folder somewhere else (default: me/ in this repo) ---
# SHERPA_HOME=~/job-search
